<?xml version="1.0" encoding="utf-8"?>
<!--
  No permissions are requested: the engine runs on SDL's dummy video driver,
  so it never touches the display, the network, storage or the clipboard.
  Everything it does happens inside the APK's own process.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.afternoodle.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <application
        android:label="afternoodle"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name="com.afternoodle.app.MainActivity"
            android:exported="true"
            android:label="afternoodle"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
